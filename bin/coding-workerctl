#!/bin/sh
set -eu

BASE=/openbayes/home/coding-worker
CONFIG="$BASE/config/worker.env"

usage() {
    echo "Usage: coding-workerctl {status|start|stop|restart|logs|queue|project|doctor|bootstrap|deploy-key-init|deploy-key-show|bind|rfc-status|wait-rfc|retry-review|record-pr|enqueue-amendment}"
}

load_config() {
    [ -f "$CONFIG" ] || {
        echo "Missing $CONFIG" >&2
        exit 1
    }
    set -a
    # shellcheck disable=SC1090
    . "$CONFIG"
    set +a
}

case "${1:-}" in
    status)
        SVDIR=/etc/service sv status coding-worker
        ;;
    start)
        SVDIR=/etc/service sv up coding-worker
        ;;
    stop)
        SVDIR=/etc/service sv down coding-worker
        ;;
    restart)
        SVDIR=/etc/service sv restart coding-worker
        ;;
    logs)
        tail -n 200 -F "$BASE/worker/logs/service/current"
        ;;
    queue)
        find "$BASE/todo" -mindepth 2 -maxdepth 2 -type f -name '*.md' -print | sort
        ;;
    project)
        load_config
        "$BASE/.venv/bin/python" "$BASE/worker/control.py" project
        ;;
    doctor)
        load_config
        "$BASE/.venv/bin/python" "$BASE/worker/doctor.py"
        ;;
    bootstrap)
        exec "$BASE/bootstrap-runtime.sh"
        ;;
    deploy-key-init)
        exec "$BASE/bin/setup-deploy-key"
        ;;
    deploy-key-show)
        [ -f "$BASE/secrets/github_deploy_key.pub" ] || {
            echo "Deploy key has not been generated. Run: coding-workerctl deploy-key-init" >&2
            exit 1
        }
        cat "$BASE/secrets/github_deploy_key.pub"
        ;;
    bind)
        shift
        exec "$BASE/bin/bind-project" "$@"
        ;;
    rfc-status)
        load_config
        [ "$#" -eq 2 ] || { usage; exit 2; }
        "$BASE/.venv/bin/python" "$BASE/worker/control.py" rfc-status "$2"
        ;;
    wait-rfc)
        load_config
        [ "$#" -eq 3 ] || { usage; exit 2; }
        "$BASE/.venv/bin/python" "$BASE/worker/control.py" wait-rfc "$2" "$3"
        ;;
    record-pr)
        load_config
        [ "$#" -eq 3 ] || { usage; exit 2; }
        "$BASE/.venv/bin/python" "$BASE/worker/control.py" record-pr "$2" "$3"
        ;;
    retry-review)
        load_config
        [ "$#" -eq 2 ] || { usage; exit 2; }
        "$BASE/.venv/bin/python" "$BASE/worker/control.py" retry-review "$2"
        ;;
    enqueue-amendment)
        load_config
        [ "$#" -eq 3 ] || { usage; exit 2; }
        "$BASE/.venv/bin/python" "$BASE/worker/control.py" enqueue-amendment "$2" "$3"
        ;;
    enqueue-upload)
        load_config
        [ "$#" -eq 3 ] || { usage; exit 2; }
        "$BASE/.venv/bin/python" "$BASE/worker/control.py" enqueue-upload "$2" "$3"
        ;;
    *)
        usage
        exit 2
        ;;
esac
