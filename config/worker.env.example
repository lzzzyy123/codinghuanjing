CODING_WORKER_HOME=/openbayes/home/coding-worker
AGENT_CLI=/openbayes/home/.local/bin/claude
PROJECT_ROOT=
BASE_BRANCH=main
GIT_REMOTE=origin

LITELLM_BASE_URL=https://your-litellm.example.com
LITELLM_API_KEY=replace-me
MODEL=xiaosuan-8

MAX_CONCURRENT_TASKS=1
MAX_REVIEW_CYCLES=3
MAX_CODER_CYCLES=5
# A large module may checkpoint work without consuming a corrective Coder cycle.
MAX_CODER_CONTINUATIONS=16
# Literal/unexecuted tool protocol output receives at most two controlled retries.
MAX_CODER_PROTOCOL_RETRIES=2
# Persistent per-RFC limits span Coder cycles and administrative retries.
MAX_CODER_PROTOCOL_FAILURES_TOTAL=8
MAX_CODER_CONTINUATIONS_TOTAL=48
MAX_CODER_LIFECYCLE_ACTIONS=64
# Administrative retries of a validated failed Coder checkpoint are bounded.
MAX_CODER_RECOVERY_ATTEMPTS=3
MAX_CONSECUTIVE_ERRORS=3
MAX_REVIEW_FORMAT_REPAIRS=2
AGENT_TIMEOUT=1800
TEST_TIMEOUT=1200
GIT_TIMEOUT=180
# Root-controlled final gate. RFC authors cannot override or disable it.
FULL_REGRESSION_COMMAND=
# Read-only Python reference used only by migration verification commands.
PYTHON_BASELINE_ROOT=
PYTHON_BASELINE_COMMIT=
POLL_INTERVAL=5
KEEP_SUCCESS_WORKTREES=false
