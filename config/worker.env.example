CODING_WORKER_HOME=/openbayes/home/coding-worker
AGENT_CLI=/openbayes/home/.local/bin/claude
PROJECT_ROOT=
BASE_BRANCH=main
GIT_REMOTE=origin

LITELLM_BASE_URL=https://your-litellm.example.com
LITELLM_API_KEY=replace-me
MODEL=xiaosuan-8

MAX_CONCURRENT_TASKS=1
MAX_REVIEW_CYCLES=3
MAX_CODER_CYCLES=5
MAX_CONSECUTIVE_ERRORS=3
MAX_REVIEW_FORMAT_REPAIRS=2
AGENT_TIMEOUT=1800
TEST_TIMEOUT=1200
GIT_TIMEOUT=180
# Root-controlled final gate. RFC authors cannot override or disable it.
FULL_REGRESSION_COMMAND=
# Read-only Python reference used only by migration verification commands.
PYTHON_BASELINE_ROOT=
PYTHON_BASELINE_COMMIT=
POLL_INTERVAL=5
KEEP_SUCCESS_WORKTREES=false

# Shadow DAG scheduler. It does not claim the legacy queue or replace the
# production watcher until an operator separately approves the cutover.
SCHEDULER_MODE=shadow
SCHEDULER_DAG=
SCHEDULER_CLASSIFICATION=
SCHEDULER_DB=/openbayes/home/coding-worker/runtime/scheduler/state.sqlite3
SCHEDULER_EVIDENCE_ROOT=/openbayes/home/coding-worker/reports/scheduler
SCHEDULER_CODER_SLOTS=1
SCHEDULER_REVIEWER_SLOTS=1
SCHEDULER_MAX_EXPENSIVE_PROCESSES=2
SCHEDULER_MIN_MEMORY_HEADROOM_BYTES=1073741824
SCHEDULER_MIN_DISK_FREE_BYTES=5368709120
